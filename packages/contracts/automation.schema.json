{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stargrid/automation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "name",
    "status",
    "trigger",
    "actions",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "paused",
        "archived"
      ]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "task.created",
            "task.status_changed",
            "calendar_event.started",
            "schedule"
          ]
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "task.create",
              "task.update",
              "calendar_event.create",
              "notification.enqueue"
            ]
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
