{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stargrid/knowledge-note.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "source_id",
    "title",
    "body",
    "status",
    "publisher",
    "created_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "needs_review",
        "published",
        "rejected",
        "superseded"
      ]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "confidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "rule-based",
            "ai-candidate"
          ]
        },
        "version": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
