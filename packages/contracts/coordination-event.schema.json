{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stargrid/coordination-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "type",
    "aggregate_type",
    "aggregate_id",
    "payload_schema_version",
    "occurred_at",
    "correlation_id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "aggregate_type": {
      "type": "string"
    },
    "aggregate_id": {
      "type": "string"
    },
    "payload_schema_version": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    }
  }
}
