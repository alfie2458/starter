{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stargrid/calendar-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "title",
    "start_at",
    "end_at",
    "timezone",
    "source",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string"
    },
    "all_day": {
      "type": "boolean"
    },
    "organizer_id": {
      "type": "string"
    },
    "attendee_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "enum": [
        "internal",
        "github",
        "other"
      ]
    },
    "external_id": {
      "type": "string"
    },
    "linked_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
