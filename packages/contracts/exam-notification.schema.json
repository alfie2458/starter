{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stargrid/exam-notification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "title",
    "exam_type",
    "exam_at",
    "scope",
    "status",
    "created_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "exam_type": {
      "enum": [
        "quiz",
        "midterm",
        "final",
        "mock",
        "gsat",
        "subject_test"
      ]
    },
    "exam_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjects"
      ],
      "properties": {
        "school": {
          "type": "string"
        },
        "academic_year": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "class_name": {
          "type": "string"
        },
        "track": {
          "enum": [
            "social",
            "science",
            "general",
            "unknown"
          ]
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "needs_review",
        "confirmed",
        "canceled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
