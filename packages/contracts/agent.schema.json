{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stargrid/agent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "provider",
    "model",
    "status",
    "capabilities",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "enum": [
        "normal",
        "observed",
        "limited",
        "paused",
        "disabled"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rpm_limit": {
      "type": "integer",
      "minimum": 0
    },
    "tpm_limit": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
