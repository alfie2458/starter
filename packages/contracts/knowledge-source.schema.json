{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stargrid/knowledge-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "kind",
    "title",
    "provenance",
    "sharing",
    "status",
    "created_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "upload",
        "github_file",
        "manual"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "content_hash": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "captured_at"
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "origin_ref": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sharing": {
      "enum": [
        "private",
        "workspace",
        "restricted"
      ]
    },
    "status": {
      "enum": [
        "uploaded",
        "screened",
        "extracted",
        "superseded",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
