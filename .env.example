# Copy to .env locally. Never commit real values.
STARGRID_ENV=development
STARGRID_LOG_LEVEL=info
# Required outside explicit local development mode.
STARGRID_API_TOKEN=
STARGRID_ALLOW_INSECURE_LOCAL=false
STARGRID_DATA_FILE=
STARGRID_MAX_BODY_BYTES=1048576
STARGRID_RATE_LIMIT=120
STARGRID_RATE_WINDOW_MS=60000
PORT=3000

STARGRID_IDENTITY_MODE=service
STARGRID_REQUIRE_WORKSPACE_AUTH=true
STARGRID_SERVICE_GITHUB_USER_ID=
STARGRID_SERVICE_ROLE=admin
STARGRID_REQUEST_TIMEOUT_MS=15000
STARGRID_BACKUP_DIR=
STARGRID_BACKUP_RETENTION=7

STARGRID_IDENTITY_MODE=service
STARGRID_REQUIRE_WORKSPACE_AUTH=true
STARGRID_SERVICE_GITHUB_USER_ID=
STARGRID_SERVICE_ROLE=admin
STARGRID_REQUEST_TIMEOUT_MS=15000
STARGRID_BACKUP_DIR=
STARGRID_BACKUP_RETENTION=7
